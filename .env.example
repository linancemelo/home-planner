# Optional AI vision keys for floor-plan import (architecture-first stubs).
# Copy to .env.local — never commit real keys.
# When unset, import uses heuristic detect + rules only (badge: 啟發式).

# VITE_OPENAI_API_KEY=
# VITE_GEMINI_API_KEY=

# Local FastAPI detect backend (mock or YOLO).
# DEFAULT: unset / empty / "off" → backend disabled (GitHub Pages won’t wait on localhost).
# Dev: uncomment to enable; failure is fast (~0.4s health); detect POST allows ~30s for YOLO.
# VITE_DETECT_API_URL=http://127.0.0.1:8000

# Backend-only (export in shell / scripts/dev-local.sh), not Vite:
# DETECT_MODE=yolo
# DETECT_SCALE_M=10
# DETECT_MODEL_PATH=/path/to/floorplan-seg.pt
