# Optional AI vision keys for floor-plan import (architecture-first stubs).
# Copy to .env.local — never commit real keys.
# When unset, import uses heuristic detect + rules only (badge: 啟發式).

# VITE_OPENAI_API_KEY=
# VITE_GEMINI_API_KEY=

# Local FastAPI detect backend (mock JSON; YOLO later).
# Default in code: http://127.0.0.1:8000 — set to empty or "off" to skip backend.
# VITE_DETECT_API_URL=http://127.0.0.1:8000
